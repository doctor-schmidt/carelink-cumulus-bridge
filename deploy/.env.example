# Copia este fichero a .env y rellena los dos primeros valores.
#   cp .env.example .env && chmod 600 .env

# ---------------------------------------------------------------------------
# OBLIGATORIAS
# ---------------------------------------------------------------------------

# Contenido COMPLETO de logindata.json, en UNA SOLA LÍNEA.
# Lo genera el dueño de los datos en su PC con:  npm run login
# ⚠️ Es una credencial: da acceso a los datos de salud del paciente.
LOGINDATA_JSON={"access_token":"...","refresh_token":"...","client_id":"...","token_url":"..."}

# Protege la lectura. Sin esto el endpoint queda ABIERTO a internet.
# Genera uno con:  openssl rand -hex 24
API_SECRET=

# ---------------------------------------------------------------------------
# OPCIONALES (los valores por defecto ya son razonables)
# ---------------------------------------------------------------------------

# EU (por defecto) o US
MMCONNECT_SERVER=EU

# Segundos entre consultas a CareLink. No bajar de 60.
POLL_INTERVAL=60

# Segundos tras los cuales /health devuelve 503 por datos rancios.
STALE_AFTER=900

# Sólo si la cuenta de cuidador sigue a varios pacientes.
CARELINK_PATIENT=
